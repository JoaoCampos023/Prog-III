@using SistemaAereo.Models.Entities
@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Clientes Inativos";
    var totalInactive = ViewBag.TotalInactive;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-2 text-dark">
            <i class="fas fa-user-slash text-secondary me-2"></i>Clientes Inativos
        </h1>
        <p class="text-muted mb-0">Gerencie clientes desativados do sistema</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-users me-2"></i>Clientes Ativos
        </a>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-user-plus me-2"></i>Novo Cliente
        </a>
    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Clientes Inativos</h6>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Email</th>
                            <th>Telefone</th>
                            <th>Cidade</th>
                            <th>Data Inativação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td>@customer.CustomerId</td>
                                <td><strong>@customer.Name</strong></td>
                                <td>@customer.Email</td>
                                <td>@(string.IsNullOrEmpty(customer.Phone) ? "—" : customer.Phone)</td>
                                <td>@(string.IsNullOrEmpty(customer.City) ? "—" : customer.City)</td>
                                <td>@customer.RegistrationDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="btn-group-action">
                                        <a asp-action="Edit" asp-route-id="@customer.CustomerId" class="btn btn-edit btn-sm-action" title="Editar">
                                            <i class="fas fa-edit"></i> Editar
                                        </a>
                                        <form asp-action="Reactivate" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja reativar este cliente?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@customer.CustomerId" />
                                            <button type="submit" class="btn btn-reactivate btn-sm-action" title="Reativar">
                                                <i class="fas fa-user-check"></i> Reativar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                    <i class="fas fa-user-check fa-2x text-muted"></i>
                </div>
                <h5 class="text-muted">Nenhum cliente inativo</h5>
                <p class="text-muted mb-4">Todos os clientes estão ativos no momento.</p>
                <a asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-arrow-left me-2"></i>Voltar para Clientes Ativos
                </a>
            </div>
        }
    </div>
</div>