@using SistemaAereo.Models.Entities
@model IEnumerable<Airport>

@{
    ViewData["Title"] = "Aeroportos";
}

<div class="d-flex justify-content-end mb-4">
    <a asp-action="Create" class="btn btn-success">
        <i class="fas fa-plus me-2"></i>Novo Aeroporto
    </a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Sucesso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Cards de Estatísticas -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Total de Aeroportos</h6>
                        <h2 class="mb-0">@Model.Count()</h2>
                    </div>
                    <i class="fas fa-building fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Países Atendidos</h6>
                        <h2 class="mb-0">@Model.Select(a => a.Country).Distinct().Count()</h2>
                    </div>
                    <i class="fas fa-globe fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Cidades Atendidas</h6>
                        <h2 class="mb-0">@Model.Select(a => a.City).Distinct().Count()</h2>
                    </div>
                    <i class="fas fa-city fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Lista de Aeroportos</h6>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>Nome</th>
                            <th>Código IATA</th>
                            <th>Cidade</th>
                            <th>País</th>
                            <th width="100">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var airport in Model)
                        {
                            <tr>
                                <td>@airport.Name</td>
                                <td>@airport.IATACode</td>
                                <td>@airport.City</td>
                                <td>@airport.Country</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@airport.AirportId" class="btn btn-warning btn-sm" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Tem certeza que deseja excluir este aeroporto?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@airport.AirportId" />
                                            <button type="submit" class="btn btn-danger btn-sm" title="Excluir">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                    <i class="fas fa-building fa-2x text-muted"></i>
                </div>
                <h5 class="text-muted">Nenhum aeroporto cadastrado</h5>
                <p class="text-muted mb-4">Comece cadastrando o primeiro aeroporto do sistema.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Cadastrar Primeiro Aeroporto
                </a>
            </div>
        }
    </div>
</div>