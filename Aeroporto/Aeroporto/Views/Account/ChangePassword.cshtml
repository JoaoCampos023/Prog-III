@model SistemaAereo.Models.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Alterar Senha";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2"><i class="fas fa-key"></i> Alterar Senha</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a asp-action="Profile" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Alterar Senha</h6>
                </div>
                <div class="card-body">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Senha Atual
                            </label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" type="password" class="form-control" id="CurrentPassword" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPassword" onclick="togglePassword('CurrentPassword', 'toggleCurrentPassword')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label">
                                <i class="fas fa-key me-2"></i>Nova Senha
                            </label>
                            <div class="input-group">
                                <input asp-for="NewPassword" type="password" class="form-control" id="NewPassword" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleNewPassword" onclick="togglePassword('NewPassword', 'toggleNewPassword')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                            <div class="password-requirements mt-2">
                                <i class="fas fa-info-circle"></i> <strong>Requisitos da senha:</strong>
                                <ul class="mb-0 mt-1">
                                    <li>No mínimo 6 caracteres</li>
                                    <li>Pelo menos uma letra maiúscula (A-Z)</li>
                                    <li>Pelo menos uma letra minúscula (a-z)</li>
                                    <li>Pelo menos um número (0-9)</li>
                                </ul>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">
                                <i class="fas fa-check-circle me-2"></i>Confirmar Nova Senha
                            </label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" id="ConfirmPassword" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword" onclick="togglePassword('ConfirmPassword', 'toggleConfirmPassword')">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Alterar Senha
                        </button>
                        <a asp-action="Profile" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/show-password.js"></script>
}