@using SistemaAereo.Models.Entities
@using SistemaAereo.Models.Enums
@model SistemaAereo.Models.ViewModels.PaginationViewModel<Ticket>

@{
    ViewData["Title"] = "Passagens";
}

<div class="container-fluid">
    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Nova Passagem
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Cards de Estatísticas -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">Total de Passagens</h6>
                            <h2 class="mb-0">@Model.TotalItems</h2>
                        </div>
                        <i class="fas fa-ticket-alt fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">Confirmadas</h6>
                            <h2 class="mb-0">@Model.Items.Count(t => t.Status == TicketStatus.Confirmed)</h2>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">Check-in Realizado</h6>
                            <h2 class="mb-0">@Model.Items.Count(t => t.Status == TicketStatus.CheckIn)</h2>
                        </div>
                        <i class="fas fa-clipboard-list fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">Canceladas</h6>
                            <h2 class="mb-0">@Model.Items.Count(t => t.Status == TicketStatus.Cancelled)</h2>
                        </div>
                        <i class="fas fa-times-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Filtros</h6>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Todos</option>
                        @foreach (var status in ViewBag.StatusOptions as string[])
                        {
                            if (ViewBag.StatusFilter == status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Itens por página</label>
                    <select name="itemsPerPage" class="form-select" onchange="this.form.submit()">
                        @foreach (var option in ViewBag.ItemsPerPageOptions as int[])
                        {
                            if (ViewBag.CurrentItemsPerPage == option)
                            {
                                <option value="@option" selected>@option</option>
                            }
                            else
                            {
                                <option value="@option">@option</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary form-control">
                        <i class="fas fa-search"></i> Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Lista de Passagens</h6>
        </div>
        <div class="card-body">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Nº Bilhete</th>
                                <th>Cliente</th>
                                <th>Voo</th>
                                <th>Poltrona</th>
                                <th>Data Emissão</th>
                                <th>Preço</th>
                                <th>Status</th>
                                <th width="100">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.Items)
                            {
                                <tr>
                                    <td>@ticket.TicketNumber</td>
                                    <td>@ticket.Customer?.Name</td>
                                    <td>@ticket.Flight?.FlightNumber</td>
                                    <td>@ticket.Seat?.SeatNumber</td>
                                    <td>@ticket.IssueDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@ticket.Price.ToString("C")</td>
                                    <td>
                                        @if (ticket.Status == TicketStatus.Confirmed)
                                        {
                                            <span class="badge bg-primary">Confirmada</span>
                                        }
                                        else if (ticket.Status == TicketStatus.CheckIn)
                                        {
                                            <span class="badge bg-warning">Check-in</span>
                                        }
                                        else if (ticket.Status == TicketStatus.Boarded)
                                        {
                                            <span class="badge bg-success">Embarcada</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Cancelada</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@ticket.TicketId" class="btn btn-info btn-sm" title="Detalhes">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (ticket.Status == TicketStatus.Confirmed)
                                            {
                                                <a asp-action="Checkin" asp-route-id="@ticket.TicketId" class="btn btn-warning btn-sm" title="Check-in">
                                                    <i class="fas fa-check-in"></i>
                                                </a>
                                            }
                                            @if (ticket.Status == TicketStatus.CheckIn)
                                            {
                                                <a asp-action="Boarding" asp-route-id="@ticket.TicketId" class="btn btn-success btn-sm" title="Embarque">
                                                    <i class="fas fa-plane"></i>
                                                </a>
                                            }
                                            @if (ticket.Status != TicketStatus.Cancelled && ticket.Status != TicketStatus.Boarded)
                                            {
                                                <a asp-action="Cancel" asp-route-id="@ticket.TicketId" class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Tem certeza que deseja cancelar esta passagem?')" title="Cancelar">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginação -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Navegação de páginas">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link" asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-itemsPerPage="@ViewBag.CurrentItemsPerPage"
                                   asp-route-status="@ViewBag.StatusFilter">
                                    <i class="fas fa-chevron-left"></i> Anterior
                                </a>
                            </li>
                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <li class="page-item active"><span class="page-link">@i</span></li>
                                }
                                else if (Math.Abs(i - Model.CurrentPage) <= 2 || i == 1 || i == Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link" asp-route-page="@i"
                                           asp-route-itemsPerPage="@ViewBag.CurrentItemsPerPage"
                                           asp-route-status="@ViewBag.StatusFilter">@i</a>
                                    </li>
                                }
                                else if (Math.Abs(i - Model.CurrentPage) == 3)
                                {
                                    <li class="page-item disabled"><span class="page-link">...</span></li>
                                }
                            }
                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link" asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-itemsPerPage="@ViewBag.CurrentItemsPerPage"
                                   asp-route-status="@ViewBag.StatusFilter">
                                    Próximo <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }

                <div class="text-center text-muted">
                    <small>Mostrando @Model.Items.Count() de @Model.TotalItems passagens (Página @Model.CurrentPage de @Model.TotalPages)</small>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="fas fa-ticket-alt fa-2x text-muted"></i>
                    </div>
                    <h5 class="text-muted">Nenhuma passagem encontrada</h5>
                    <p class="text-muted mb-4">Comece emitindo a primeira passagem do sistema.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Emitir Primeira Passagem
                    </a>
                </div>
            }
        </div>
    </div>
</div>