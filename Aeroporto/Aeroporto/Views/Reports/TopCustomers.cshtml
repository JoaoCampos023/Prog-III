@model SistemaAereo.Models.ViewModels.TopCustomersReportViewModel

@{
    ViewData["Title"] = "Clientes Mais Frequentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0">Clientes Mais Frequentes</h1>
        <p class="text-muted mb-0">Ranking de clientes que mais viajam</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Voltar
    </a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h6 class="mb-0">Total de Clientes</h6>
                <h2 class="mb-0">@Model.TotalCustomers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h6 class="mb-0">Clientes Ativos</h6>
                <h2 class="mb-0">@Model.TotalActiveCustomers</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">Ranking de Clientes</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Posição</th>
                        <th>Cliente</th>
                        <th>Email</th>
                        <th>Total Passagens</th>
                        <th>Valor Total</th>
                        <th>Ticket Médio</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.TopCustomers.Count; i++)
                    {
                        var customer = Model.TopCustomers[i];
                        <tr>
                            <td>
                                @if (i == 0)
                                {
                                    <span class="badge bg-warning fs-6">🥇 1º</span>
                                }
                                else if (i == 1)
                                {
                                    <span class="badge bg-secondary fs-6">🥈 2º</span>
                                }
                                else if (i == 2)
                                {
                                    <span class="badge bg-danger fs-6">🥉 3º</span>
                                }
                                else
                                {
                                    <span>@(i + 1)º</span>
                                }
                            </td>
                            <td><strong>@customer.Name</strong></td>
                            <td>@customer.Email</td>
                            <td><span class="badge bg-info">@customer.TotalTickets</span></td>
                            <td>@customer.TotalAmount.ToString("C")</td>
                            <td>@customer.AverageTicketPrice.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.TopCustomers.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-users fa-3x text-muted mb-3"></i>
                <h5 class="text-muted">Nenhum dado disponível</h5>
                <p class="text-muted">Ainda não há passagens emitidas para gerar o ranking.</p>
            </div>
        }
    </div>
</div>